{
	"name": "@mastra/surrealdb",
	"version": "0.1.0",
	"description": "SurrealDB storage adapter for Mastra AI",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"license": "Apache-2.0",
	"dependencies": {
		"surrealdb": "^2.0.3"
	},
	"devDependencies": {
		"@mastra/core": "^1.31.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3"
	},
	"peerDependencies": {
		"@mastra/core": ">=1.31.0-0 <2.0.0-0"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	}
}
