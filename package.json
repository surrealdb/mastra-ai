{
	"name": "mastra-surrealdb",
	"private": true,
	"version": "0.0.0",
	"description": "SurrealDB storage adapter for Mastra AI",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"build": "bun --filter './packages/**' build",
		"dev": "bun --filter './packages/**' dev",
		"test": "bun --filter './packages/**' test",
		"typecheck": "bun --filter './packages/**' typecheck",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"typescript": "^5.8.3"
	}
}
