{
	"name": "@surrealdb/mastra-ai",
	"version": "0.2.0",
	"description": "SurrealDB storage adapter for Mastra AI",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./spectron": {
			"import": {
				"types": "./dist/spectron/index.d.ts",
				"default": "./dist/spectron/index.js"
			},
			"require": {
				"types": "./dist/spectron/index.d.cts",
				"default": "./dist/spectron/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"license": "Apache-2.0",
	"engines": {
		"bun": ">=1.0.0"
	},
	"dependencies": {
		"@surrealdb/spectron": "^1.0.0-alpha.4",
		"surrealdb": "^2.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@mastra/core": "^1.52.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@mastra/core": ">=1.31.0-0 <2.0.0-0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest watch",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write ."
	}
}
