{
	"name": "@surrealdb/mastra-ai",
	"version": "1.0.0-beta.2",
	"description": "SurrealDB storage adapter for Mastra AI",
	"type": "module",
	"sideEffects": false,
	"keywords": [
		"surrealdb",
		"mastra",
		"ai",
		"agent",
		"memory",
		"storage",
		"vector",
		"rag"
	],
	"homepage": "https://github.com/surrealdb/mastra-ai#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/mastra-ai.git"
	},
	"bugs": {
		"url": "https://github.com/surrealdb/mastra-ai/issues"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./agent-memory": {
			"import": {
				"types": "./dist/agent-memory/index.d.ts",
				"default": "./dist/agent-memory/index.js"
			},
			"require": {
				"types": "./dist/agent-memory/index.d.cts",
				"default": "./dist/agent-memory/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.13.0",
		"bun": ">=1.0.0"
	},
	"dependencies": {
		"@surrealdb/memory": "^1.0.0-alpha.9",
		"surrealdb": "^2.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@mastra/core": "^1.63.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@mastra/core": ">=1.31.0-0 <2.0.0-0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"files": [
		"dist",
		"src",
		"!src/tests",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest watch",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:ci": "biome ci ."
	}
}
